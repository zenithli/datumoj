+"""Check a complete plan artifact, optionally comparing its HTTP responses.
+
+Offline: python scripts/check_plan_site.py /path/to/approved-artifact/plan
+HTTP: append --url https://preview.example/plan/ (read-only GETs, no credentials).
+This is an acceptance gate, not a builder/deployer or a full datumoj.com backup.
+Python 3.12+, standard library only. See docs/plan-publication.md for boundaries.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+from html.parser import HTMLParser
+from pathlib import Path
+from urllib.error import URLError
+from urllib.parse import urljoin, urlsplit
+from urllib.request import Request, urlopen
+
+CONTENT_TYPES = {".html": "text/html", ".json": "application/json", ".svg": "image/svg+xml", ".png": "image/png"}
+# Includes the two live-only research sections and the known image dependency.
+# This list is not an inventory of the rest of datumoj.com.
+REQUIRED = (
+    "index.html", "milestones.json", "assets/architecture.svg", "assets/swimlane.svg",
+    "orbis/index.html", "cases/index.html", "verify/index.html", "hf-gov/index.html", "hf-gov/datasets.json",
+    "agent-org/index.html", "hyoki-yure/index.html", "hyoki-yure/sai-variants.png",
+)
+MAX_BYTES = 5 * 1024 * 1024
+
+
+class Page(HTMLParser):
+    def __init__(self):
+        super().__init__()
+        self.links = set()
+        self.has_base = False
+
+    def handle_starttag(self, tag, attrs):
+        attrs = dict(attrs)
+        if tag == "a":
+            self.links.add(attrs.get("href"))
+        if tag == "base":
+            self.has_base = True
+
+
+def check_artifact(root: Path) -> dict[str, bytes]:
+    """Validate known plan files without changing the artifact; fail closed."""
+    missing = [name for name in REQUIRED if not (root / name).is_file()]
+    if missing:
+        raise ValueError("missing artifact files: " + ", ".join(missing))
+    for name in REQUIRED:
+        if (root / name).stat().st_size > MAX_BYTES:
+            raise ValueError(f"artifact file too large: {name}")
+    files = {name: (root / name).read_bytes() for name in REQUIRED}
+    page = files["index.html"].decode("utf-8")
+    parsed = Page()
+    parsed.feed(page)
+    if (not {"agent-org/", "hyoki-yure/"} <= parsed.links
+            or "Agent 自组织与动态多中心治理" not in page or "表記ゆれ：从文字差异到实体解析" not in page):
+        raise ValueError("index.html: missing research announcement links")
+    if parsed.has_base or not re.search(r'''fetch\(\s*["']milestones\.json["']\s*,''', page):
+        raise ValueError("index.html: expected relative milestones.json fetch without a base override")
+    try:
+        data = json.loads(files["milestones.json"])
+        versions = data["versions"]
+        milestones = data["milestones"]
+        statuses = {"done", "doing", "pending", "planned"}
+        if not isinstance(data["updated"], str) or not data["updated"]:
+            raise ValueError
+        if not isinstance(versions, list) or not versions or not isinstance(milestones, list) or not milestones:
+            raise ValueError
+        if any(not v["version"] or not v["codename"] or v["status"] not in statuses for v in versions):
+            raise ValueError
+        known = {v["version"] for v in versions}
+        if any(not m["id"] or not m["title"] or m["version"] not in known or m["status"] not in statuses
+               for m in milestones):
+            raise ValueError
+    except (KeyError, TypeError, ValueError) as exc:
+        raise ValueError("milestones.json: invalid JSON or renderer fields") from exc
+    return files
+
+
+def check_http(files: dict[str, bytes], base_url: str) -> None:
+    """Compare approved local bytes with bounded, unauthenticated HTTP GETs."""
+    url = urlsplit(base_url)
+    if (url.scheme not in {"http", "https"} or not url.netloc or not url.path.endswith("/")
+            or url.username or url.password or url.query or url.fragment):
+        raise ValueError("base URL must be HTTP(S), end in '/', and contain no credentials/query/fragment")
+    for name, expected in files.items():
+        # Fetch canonical directory routes as a browser does, including /plan/.
+        route = "" if name == "index.html" else name.removesuffix("index.html")
+        request = Request(urljoin(base_url, route), headers={"Cache-Control": "no-cache"})
+        with urlopen(request, timeout=15) as response:
+            mime = CONTENT_TYPES[Path(name).suffix]
+            if response.status != 200 or response.headers.get_content_type() != mime:
+                raise ValueError(f"{name}: expected HTTP 200 {mime}, not fallback/error content")
+            actual = response.read(MAX_BYTES + 1)
+            if len(actual) > MAX_BYTES or actual != expected:
+                raise ValueError(f"{name}: response differs from approved artifact (stale build or fallback)")
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("root", type=Path, help="complete plan subtree, not the site's root")
+    parser.add_argument("--url", help="optional exact HTTP(S) plan base URL ending in /")
+    args = parser.parse_args(argv)
+    try:
+        files = check_artifact(args.root)
+        if args.url:
+            check_http(files, args.url)
+    except (OSError, ValueError, URLError) as exc:
+        print(f"FAIL: {exc}")
+        return 1
+    print(f"PASS: {len(files)} known plan files checked" + (" against HTTP" if args.url else " offline"))
+    print("This does not authorize publication or verify the rest of datumoj.com.")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
