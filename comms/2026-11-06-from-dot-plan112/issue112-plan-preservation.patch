+@pytest.mark.parametrize("mount", ["/", "/plan/"])
+def test_http_checker_resolves_relative_files_at_both_mounts(checker, artifact, httpserver, mount):
+    checked = checker["check_artifact"](artifact)
+    for path, body in checked.items():
+        route = mount if path == "index.html" else mount + path.replace("/index.html", "/")
+        mime = checker["CONTENT_TYPES"][Path(path).suffix]
+        httpserver.expect_request(route, method="GET").respond_with_data(body, content_type=mime)
+    checker["check_http"](checked, httpserver.url_for(mount))
+    httpserver.check_assertions()
+
+
+@pytest.mark.parametrize("mime,body", [
