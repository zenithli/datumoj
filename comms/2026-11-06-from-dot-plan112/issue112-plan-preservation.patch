+"""Regressions for preserving the plan page before repairing publication."""
+
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def test_plan_preserves_both_verified_live_announcements():
+    """A main-based publish must not silently lose the two live notices."""
+    expected = (ROOT / "tests/fixtures/plan/announcements.html").read_text(encoding="utf-8").splitlines()
+    page = (ROOT / "plan/index.html").read_text(encoding="utf-8")
+    assert len(expected) == 2
+    for announcement in expected:
+        assert page.count(announcement) == 1
+
+
+import json
+import runpy
+import shutil
+
+import pytest
+
+
+@pytest.fixture
+def checker():
+    path = ROOT / "scripts/check_plan_site.py"
+    assert path.is_file(), "artifact acceptance checker is not implemented"
+    return runpy.run_path(str(path))
+
+
+@pytest.fixture
+def artifact(tmp_path):
+    root = tmp_path / "site" / "plan"
+    shutil.copytree(ROOT / "plan", root)
+    # Synthetic local-only fixtures, not replacements for the missing live pages.
+    for page in ("agent-org", "hyoki-yure"):
+        (root / page).mkdir()
+        (root / page / "index.html").write_text(f"<!doctype html><title>{page} fixture</title>")
+    (root / "hyoki-yure/sai-variants.png").write_bytes(b"\x89PNG\r\n\x1a\nfixture")
+    return root
+
+
+def test_checker_accepts_complete_artifact_without_writes(checker, artifact):
+    before = {p.relative_to(artifact): p.read_bytes() for p in artifact.rglob("*") if p.is_file()}
+    checked = checker["check_artifact"](artifact)
+    assert "milestones.json" in checked
+    assert "agent-org/index.html" in checked
+    assert "hyoki-yure/sai-variants.png" in checked
+    assert before == {p.relative_to(artifact): p.read_bytes() for p in artifact.rglob("*") if p.is_file()}
+
+
+@pytest.mark.parametrize("missing", ["milestones.json", "agent-org/index.html", "hyoki-yure/sai-variants.png"])
+def test_checker_rejects_incomplete_publish_directory(checker, artifact, missing):
+    (artifact / missing).unlink()
+    with pytest.raises(ValueError, match="missing"):
+        checker["check_artifact"](artifact)
+
+
+@pytest.mark.parametrize("body", [b"<!doctype html><title>SPA fallback</title>", b"{}", b'{"versions":[],"milestones":[]}'])
+def test_checker_rejects_html_and_unrenderable_milestone_data(checker, artifact, body):
+    (artifact / "milestones.json").write_bytes(body)
